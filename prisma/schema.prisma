// prisma/schema.prisma
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model ContactMessage {
  id      Int     @id @default(autoincrement())
  name    String
  email   String
  message String
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortfolioChunk {
  id        String                       @id @default(cuid())
  content   String
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
}

model ExperienceEntry {
  id          String   @id @default(cuid())
  title       String
  company     String
  period      String
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SkillEntry {
  id        String   @id @default(cuid())
  category  String
  name      String
  level     String
  icon      String
  status    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CertificationEntry {
  id         String    @id @default(cuid())
  name       String
  issuer     String
  status     String
  issuedDate DateTime?
  url        String?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model PendingResumeChange {
  id           String    @id @default(cuid())
  targetType   String
  targetId     String?
  changeType   String
  proposedData Json
  previousData Json?
  sourceNote   String
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
}